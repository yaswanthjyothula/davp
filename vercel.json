{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/dashboard/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/ezgif-(.*)",
      "dest": "/ezgif-$1"
    },
    {
      "src": "/(style\\.css|app\\.js|f1-logo.*|f1\\.svg|dashboard\\.html)",
      "dest": "/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/dashboard(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/_dash-(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
