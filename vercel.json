{
  "version": 2,
  "cleanUrls": false,
  "framework": null,
  "buildCommand": "echo 'Static build complete'",
  "installCommand": "echo 'Skipping backend Python installation on Vercel'",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "https://f1davap.onrender.com/dashboard/"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://f1davap.onrender.com/dashboard/:path*"
    },
    {
      "source": "/_dash-:path*",
      "destination": "https://f1davap.onrender.com/_dash-:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://f1davap.onrender.com/assets/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "*"
        }
      ]
    }
  ]
}
